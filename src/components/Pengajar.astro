---
import { site } from '@/data/site';
---

<section id="pengajar" class="section bg-[#fbf7ee] text-on-surface" aria-labelledby="pengajar-title">
  <div class="section-header">
    <span class="section-label">Kualifikasi Sanad Keilmuan</span>
    <h2 id="pengajar-title" class="section-title-md3">Tenaga Pendidik & Pengajar</h2>
    <div class="section-divider" aria-hidden="true"></div>
  </div>

  <!-- Paragraf Pengantar Resmi -->
  <div class="card-elevated-lg text-center">
    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed">
      Tenaga pendidik dan pengajar sudah berpengalaman di bidangnya masing-masing, di antaranya bergelar sarjana dan magister, dan beberapa memiliki sertifikasi keterampilan khusus.
    </p>
  </div>

  <!-- 5 Badge Almamater Terkemuka -->
  <div class="flex flex-col gap-space-sm">
    <span class="font-label-md text-label-md text-primary font-bold uppercase tracking-wider text-center">Lulusan Almamater Terkemuka</span>

    <div class="almamater-item">
      <div class="almamater-icon" aria-hidden="true">
        <span class="material-symbols-outlined text-[22px]">public</span>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="almamater-name">Universitas Al-Azhar Cairo</span>
        <span class="almamater-desc">Mesir — Sanad Keilmuan Islam Global</span>
      </div>
    </div>

    <div class="almamater-item">
      <div class="almamater-icon" aria-hidden="true">
        <span class="material-symbols-outlined text-[22px]">account_balance</span>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="almamater-name">UIN Syarif Hidayatullah</span>
        <span class="almamater-desc">Jakarta — Sarjana & Magister Pendidikan Agama</span>
      </div>
    </div>

    <div class="almamater-item">
      <div class="almamater-icon" aria-hidden="true">
        <span class="material-symbols-outlined text-[22px]">account_balance</span>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="almamater-name">UIN Sunan Gunung Djati</span>
        <span class="almamater-desc">Bandung — Studi Islam & Tarbiyah</span>
      </div>
    </div>

    <div class="almamater-item">
      <div class="almamater-icon" aria-hidden="true">
        <span class="material-symbols-outlined text-[22px]">menu_book</span>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="almamater-name">Institut Ilmu Al-Qur'an (IIQ)</span>
        <span class="almamater-desc">Jakarta — Mutqin Tahfidz & Ulumul Qur'an</span>
      </div>
    </div>

    <div class="almamater-item">
      <div class="almamater-icon" aria-hidden="true">
        <span class="material-symbols-outlined text-[22px]">workspace_premium</span>
      </div>
      <div class="flex flex-col min-w-0">
        <span class="almamater-name">Alumni KMI Pondok Modern Gontor</span>
        <span class="almamater-desc">Karakter Disiplin, Bahasa & Leadership</span>
      </div>
    </div>
  </div>
</section>
