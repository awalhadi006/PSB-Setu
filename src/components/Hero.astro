---
import { heroSrc, heroSrcset, heroSizes } from '../utils/hero-image';
import Icon from './Icon.astro';
---

<section
  id="beranda"
  class="relative w-full bg-gradient-to-b from-primary-container via-[#145a41] to-primary text-on-primary px-gutter-mobile pt-space-md pb-space-xl overflow-hidden"
  aria-labelledby="hero-title"
>
  <!-- LCP photo as a real <img> so it can be srcset'd, preloaded and cheap to
       decode on a phone (a CSS background-image forces one fixed size). -->
  <img
    src={heroSrc}
    srcset={heroSrcset}
    sizes={heroSizes}
    alt=""
    aria-hidden="true"
    width="1600"
    height="1065"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 w-full h-full object-cover"
  />
  <!-- Tint + gradient, same colours as the previous background shorthand. -->
  <div
    class="absolute inset-0"
    aria-hidden="true"
    style="background-image: linear-gradient(rgba(11, 61, 46, 0.9), rgba(20, 90, 65, 0.94), rgba(0, 38, 27, 0.97));"
  >
  </div>
  <!-- Subtle Arabesque Geometric Pattern Background Watermark -->
  <div class="absolute inset-0 opacity-[0.06] pointer-events-none flex items-center justify-center">
    <svg class="w-full h-full text-secondary-container" fill="currentColor" viewBox="0 0 400 400" aria-hidden="true">
      <path d="M200 0 L230 110 L341 79 L280 170 L390 200 L280 230 L341 321 L230 290 L200 400 L170 290 L59 321 L120 230 L10 200 L120 170 L59 79 L170 110 Z" />
      <circle cx="200" cy="200" fill="none" r="160" stroke="currentColor" stroke-width="1.5" />
      <circle cx="200" cy="200" fill="none" r="120" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </div>

  <div class="relative z-10 flex flex-col items-center text-center">
    <!-- Status Chip Pendaftaran -->
    <div class="hero-status mb-space-md" role="status" aria-live="polite">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="status-text">Status: Dibuka (18 Okt 2026 - 25 Apr 2027)</span>
    </div>

    <!-- Badge Penerimaan Santri Baru -->
    <div class="hero-badge mb-space-md" aria-hidden="true">
      <Icon class="psb-badge-icon" name="school" />
      <span class="psb-badge-text">Penerimaan Santri Baru 2027-2028</span>
    </div>

    <!-- Large Title (Noto Serif) -->
    <h1 id="hero-title" class="hero-title mb-space-md">
      Pondok Pesantren <br>
      <span class="text-secondary-fixed italic font-normal">Al-Lathifah 2</span>
    </h1>

    <!-- Slogan / Tagline -->
    <div class="slogan-box mb-space-lg">
      <p class="slogan-text">"Lebih Baik Pesantren, Pesantren Lebih Baik"</p>
    </div>

    <!-- Arch Shaped Photo Placeholder (Kubah Silhouette) -->
    <div class="arch-photo mb-space-xl">
      <div class="arch-photo-inner">
        <div
          class="arch-photo-bg"
          style={`background-image: url("${heroSrc}");`}
          aria-hidden="true"
        ></div>
        <div class="arch-photo-overlay">
          <span class="arch-photo-caption">
            <Icon class="text-[15px]" name="verified" />
            Kampus Al-Lathifah 2 Setu
          </span>
          <p class="arch-photo-location">Gerbang Masuk Kampus 2 Setu, Bekasi</p>
        </div>
        <!-- Arch Golden Trim -->
        <div class="arch-trim" aria-hidden="true"></div>
      </div>
    </div>

    <!-- Action Button (Cara Mendaftar only) -->
    <div class="hero-buttons">
      <a
        class="btn-secondary-stacked"
        href="#cara-mendaftar"
        aria-label="Cara mendaftar santri baru"
        onclick="document.getElementById('cara-mendaftar').scrollIntoView({behavior: 'smooth'}); return false;"
      >
        <Icon class="text-[20px] text-secondary-fixed" name="arrow_circle_down" />
        <span>Cara Mendaftar</span>
      </a>
    </div>
  </div>
</section>

<style>
  /* Hero entrance, staggered from the chip down to the CTA.
     Pure CSS so it starts at first paint without waiting for any script.
     The background photo is deliberately NOT animated: it is the LCP element
     and fading it in would delay the largest contentful paint. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-status,
    .hero-badge,
    .hero-title,
    .slogan-box,
    .arch-photo,
    .hero-buttons {
      animation: hero-rise 0.62s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-badge { animation-delay: 70ms; }
    .hero-title { animation-delay: 140ms; }
    .slogan-box { animation-delay: 210ms; }
    .arch-photo { animation-delay: 280ms; }
    .hero-buttons { animation-delay: 350ms; }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>