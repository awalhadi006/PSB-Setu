---
import Icon from './Icon.astro';
import { faqItems } from '../data/faq';
---

<section id="faq" class="section bg-surface-container-lowest text-on-surface" aria-labelledby="faq-title">
  <div class="section-header">
    <span class="section-label">Informasi Umum</span>
    <h2 id="faq-title" class="section-title-md3">Tanya Jawab (FAQ)</h2>
    <p class="section-subtext">Pertanyaan yang paling sering diajukan oleh calon wali santri.</p>
    <div class="section-divider" aria-hidden="true"></div>
  </div>

  <!-- Accordion List -->
  <div class="flex flex-col gap-2.5">
    {faqItems.map((item, i) => (
      <div class="faq-item">
        <button
          class="faq-trigger"
          aria-expanded="false"
          aria-controls={`faq-answer-${i}`}
          id={`faq-trigger-${i}`}
          onclick="toggleFaq(this)"
          type="button"
        >
          <span class="faq-question">{item.question}</span>
          <Icon class="faq-icon" name="expand_more" />
        </button>
        <div
          id={`faq-answer-${i}`}
          class="faq-answer hidden"
          role="region"
          aria-labelledby={`faq-trigger-${i}`}
        >
          {item.answer}
        </div>
      </div>
    ))}
  </div>
</section>
