---
import { site } from '@/data/site';
---

<section id="profil" class="section bg-[#fbf7ee] text-on-surface" aria-labelledby="profil-title">
  <!-- Header with 8-pointed star ornament -->
  <div class="section-header">
    <div class="flex items-center gap-2 text-secondary">
      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">emergency</span>
      <span class="font-label-sm text-label-sm uppercase tracking-widest font-bold">Lembaga Pesantren Salaf Modern</span>
      <span class="material-symbols-outlined text-[18px]" aria-hidden="true">emergency</span>
    </div>
    <h2 id="profil-title" class="section-title-md3">Profil & Sistem Pendidikan</h2>
    <div class="section-divider" aria-hidden="true"></div>
  </div>

  <!-- Blockquote Motto -->
  <div class="blockquote">
    <div class="blockquote-quote" aria-hidden="true">
      <span class="blockquote-quote-icon">format_quote</span>
    </div>
    <span class="blockquote-label">Motto Utama Santri</span>
    <p class="blockquote-text">"Sholeh, Mandiri, Berjiwa Besar"</p>
  </div>

  <!-- Kartu Sistem Pendidikan Resmi -->
  <div class="card-elevated-lg px-space-lg py-space-md">
    <div class="flex items-center gap-2 text-primary font-title-md text-title-md">
      <span class="material-symbols-outlined text-secondary" aria-hidden="true">menu_book</span>
      <h3>Sistem Pendidikan Terpadu</h3>
    </div>
    <p class="font-body-md text-body-md text-on-surface-variant leading-relaxed text-justify">
      Kurikulum Pondok Pesantren Al-Lathifah merupakan kolaborasi dari kurikulum Pesantren Salaf Modern dan Kurikulum Negara yang berbasis kecakapan hidup, dikemas secara selektif dengan didukung oleh kondisi dan lingkungan pesantren yang edukatif serta dilaksanakan dalam siklus waktu 24 jam, masa belajar 3 tahun SMP dan 3 tahun Aliyah, serta mendapatkan Ijazah Negara yang digunakan untuk melanjutkan ke jenjang pendidikan selanjutnya.
    </p>
  </div>

  <!-- Kartu Visi -->
  <div class="visi-card">
    <div class="visi-header">
      <span class="visi-icon" aria-hidden="true">lightbulb</span>
      <span class="visi-label">Visi Pondok Pesantren</span>
    </div>
    <p class="visi-text">"Membentuk generasi Qur'ani yang berpengetahuan luas, berjiwa besar dan berakhlakul karimah."</p>
  </div>

  <!-- Daftar Misi -->
  <div class="misi-card">
    <div class="misi-header">
      <span class="misi-icon" aria-hidden="true">track_changes</span>
      <h3 class="misi-title">Misi Pesantren</h3>
    </div>
    <div class="misi-list">
      <div class="misi-item">
        <div class="misi-number" aria-hidden="true">1</div>
        <p class="misi-text">Menanamkan aqidah yang lurus dan memberikan bekal pemahaman agama Islam yang benar.</p>
      </div>
      <div class="misi-item">
        <div class="misi-number" aria-hidden="true">2</div>
        <p class="misi-text">Menjadikan Al-Qur'an dan As-Sunnah sebagai pedoman hidup.</p>
      </div>
      <div class="misi-item">
        <div class="misi-number" aria-hidden="true">3</div>
        <p class="misi-text">Mengajarkan ilmu agama dan umum secara seimbang.</p>
      </div>
      <div class="misi-item">
        <div class="misi-number" aria-hidden="true">4</div>
        <p class="misi-text">Membangun kepribadian yang mandiri dengan memiliki bekal keterampilan yang dapat diandalkan.</p>
      </div>
    </div>
  </div>
</section>