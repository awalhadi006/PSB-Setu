---
import { site } from '@/data/site';
---

<section id="syarat" class="section bg-[#fbf7ee] text-on-surface" aria-labelledby="syarat-title">
  <div class="section-header">
    <span class="section-label">Kelengkapan Administrasi</span>
    <h2 id="syarat-title" class="section-title-md3">Persyaratan Pendaftaran</h2>
    <p class="section-subtext">Mohon siapkan dokumen fisik untuk diserahkan ke sekretariat panitia PSB.</p>
    <div class="section-divider" aria-hidden="true"></div>
  </div>

  <!-- 10 Checklist Items -->
  <div class="flex flex-col gap-2">
    <!-- 1 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">1</div>
      <span class="syarat-text">Mengisi formulir pendaftaran</span>
    </div>
    <!-- 2 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">2</div>
      <span class="syarat-text">Pas foto 2x3 sebanyak 5 lembar, latar merah</span>
    </div>
    <!-- 3 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">3</div>
      <span class="syarat-text">Fotokopi Kartu Keluarga (KK)</span>
    </div>
    <!-- 4 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">4</div>
      <span class="syarat-text">Fotokopi Akta Kelahiran</span>
    </div>
    <!-- 5 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">5</div>
      <span class="syarat-text">Fotokopi NISN</span>
    </div>
    <!-- 6 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">6</div>
      <span class="syarat-text">Fotokopi Ijazah (menyusul)</span>
    </div>
    <!-- 7 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">7</div>
      <span class="syarat-text">Surat Keterangan Lulus (SKL)</span>
    </div>
    <!-- 8 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">8</div>
      <div class="syarat-text-col">
        <span class="syarat-text">Surat Keterangan Kematian</span>
        <span class="syarat-subtext">Bagi santri yatim / piatu</span>
      </div>
      <span class="badge-khusus">Khusus Yatim</span>
    </div>
    <!-- 9 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">9</div>
      <div class="syarat-text-col">
        <span class="syarat-text">Surat Keterangan Tidak Mampu</span>
        <span class="syarat-subtext">Dari RT/RW & Kelurahan</span>
      </div>
      <span class="badge-khusus">Khusus Dhuafa</span>
    </div>
    <!-- 10 -->
    <div class="syarat-item">
      <div class="syarat-number" aria-hidden="true">10</div>
      <div class="syarat-text-col">
        <span class="syarat-text">Dokumentasi Tempat Tinggal</span>
        <span class="syarat-subtext">Foto rumah tampak depan & dalam</span>
      </div>
      <span class="badge-khusus">Khusus Dhuafa</span>
    </div>
  </div>
</section>