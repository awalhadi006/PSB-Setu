---
// Inline tileable 8-point star (rub el hizb) motif — no external assets.
// Unique id per instance so multiple dividers can coexist on a page.
const patternId = `sd-pattern-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="section-divider" aria-hidden="true">
  <svg
    class="section-divider__svg"
    width="100%"
    height="60"
    xmlns="http://www.w3.org/2000/svg"
    focusable="false"
  >
    <defs>
      <pattern
        id={patternId}
        width="60"
        height="60"
        patternUnits="userSpaceOnUse"
        patternTransform="translate(30 0)"
      >
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-linejoin="round"
        >
          <polygon points="30,4 56,30 30,56 4,30" />
          <polygon points="30,12 48,30 30,48 12,30" />
          <polygon points="30,20 36,26 44,26 38,32 40,40 34,34 26,40 28,32 22,26 30,26" />
        </g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${patternId})`} />
  </svg>
</div>

<style>
  .section-divider {
    --pattern-color: #c9a227;
    --pattern-opacity: 0.05;

    width: 100%;
    height: 60px;
    color: var(--pattern-color);
    opacity: var(--pattern-opacity);
  }

  .section-divider__svg {
    display: block;
    width: 100%;
    height: 60px;
  }
</style>
