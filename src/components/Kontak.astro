---
import { site } from '@/data/site';
import Icon from './Icon.astro';
---

<section id="kontak" class="section bg-[#0b3d2e] text-white" aria-labelledby="kontak-title">
  <!-- Media Sosial Resmi Header -->
  <div class="kontak-medso-header">
    <div class="kontak-medso-title-row">
      <span class="kontak-medso-title">
        <Icon class="text-[18px]" name="share" />
        Media Sosial Resmi
      </span>
      <span class="kontak-medso-subtitle">Ikuti Perkembangan Santri</span>
    </div>
    <div class="medsos-grid">
      <a class="medsos-item" href={site.kontak.mediaSosial?.instagram || 'https://instagram.com'} rel="noopener noreferrer" target="_blank">
        <div class="flex items-center gap-3">
          <div class="medsos-icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor"><title>instagram</title><path fill="currentColor" d="M17.34 5.46a1.2 1.2 0 1 0 1.2 1.2a1.2 1.2 0 0 0-1.2-1.2m4.6 2.42a7.6 7.6 0 0 0-.46-2.43a4.9 4.9 0 0 0-1.16-1.77a4.7 4.7 0 0 0-1.77-1.15a7.3 7.3 0 0 0-2.43-.47C15.06 2 14.72 2 12 2s-3.06 0-4.12.06a7.3 7.3 0 0 0-2.43.47a4.8 4.8 0 0 0-1.77 1.15a4.7 4.7 0 0 0-1.15 1.77a7.3 7.3 0 0 0-.47 2.43C2 8.94 2 9.28 2 12s0 3.06.06 4.12a7.3 7.3 0 0 0 .47 2.43a4.7 4.7 0 0 0 1.15 1.77a4.8 4.8 0 0 0 1.77 1.15a7.3 7.3 0 0 0 2.43.47C8.94 22 9.28 22 12 22s3.06 0 4.12-.06a7.3 7.3 0 0 0 2.43-.47a4.7 4.7 0 0 0 1.77-1.15a4.85 4.85 0 0 0 1.16-1.77a7.6 7.6 0 0 0 .46-2.43c0-1.06.06-1.4.06-4.12s0-3.06-.06-4.12M20.14 16a5.6 5.6 0 0 1-.34 1.86a3.06 3.06 0 0 1-.75 1.15a3.2 3.2 0 0 1-1.15.75a5.6 5.6 0 0 1-1.86.34c-1 .05-1.37.06-4 .06s-3 0-4-.06a5.7 5.7 0 0 1-1.94-.3a3.3 3.3 0 0 1-1.1-.75a3 3 0 0 1-.74-1.15a5.5 5.5 0 0 1-.4-1.9c0-1-.06-1.37-.06-4s0-3 .06-4a5.5 5.5 0 0 1 .35-1.9A3 3 0 0 1 5 5a3.1 3.1 0 0 1 1.1-.8A5.7 5.7 0 0 1 8 3.86c1 0 1.37-.06 4-.06s3 0 4 .06a5.6 5.6 0 0 1 1.86.34a3.06 3.06 0 0 1 1.19.8a3.1 3.1 0 0 1 .75 1.1a5.6 5.6 0 0 1 .34 1.9c.05 1 .06 1.37.06 4s-.01 3-.06 4M12 6.87A5.13 5.13 0 1 0 17.14 12A5.12 5.12 0 0 0 12 6.87m0 8.46A3.33 3.33 0 1 1 15.33 12A3.33 3.33 0 0 1 12 15.33"/></svg>
          </div>
          <div class="medsos-info">
            <span class="medsos-name">Instagram</span>
            <span class="medsos-handle">@ponpesallathifah2</span>
          </div>
        </div>
        <Icon class="text-[18px] text-secondary-fixed" name="arrow_forward" />
      </a>
      <a class="medsos-item" href={site.kontak.mediaSosial?.facebook || 'https://facebook.com'} rel="noopener noreferrer" target="_blank">
        <div class="flex items-center gap-3">
          <div class="medsos-icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="currentColor"><title>facebook-24</title><path fill="currentColor" fill-rule="evenodd" d="M1 5.8c0-1.68 0-2.52.327-3.16a3.02 3.02 0 0 1 1.31-1.31c.642-.327 1.48-.327 3.16-.327h12.4c1.68 0 2.52 0 3.16.327a3.02 3.02 0 0 1 1.31 1.31c.327.642.327 1.48.327 3.16v12.4c0 1.68 0 2.52-.327 3.16a3 3 0 0 1-1.31 1.31c-.642.327-1.48.327-3.16.327h-12.4c-1.68 0-2.52 0-3.16-.327a3 3 0 0 1-1.31-1.31C1 20.718 1 19.88 1 18.2zM5.8 2h12.4c.857 0 1.44 0 1.89.038c.438.035.663.1.819.18c.376.192.682.498.874.874c.08.156.145.38.18.819c.037.45.038 1.03.038 1.89v12.4c0 .857-.001 1.44-.038 1.89c-.036.438-.101.663-.18.819a2 2 0 0 1-.874.874c-.156.08-.381.145-.819.18c-.45.036-1.03.037-1.89.037h-2.78v-8.29h2.33l.366-2.56h-2.69v-1.1q0-.28.037-.507c.107-.643.459-.96 1.2-.96h1.48v-2.45l-.016-.003c-.266-.036-.813-.11-1.83-.11c-2.17 0-3.44 1.14-3.44 3.75v1.38h-2.56v2.56h2.56v8.29h-7.05c-.857 0-1.44 0-1.89-.038c-.438-.035-.663-.1-.819-.18a2 2 0 0 1-.874-.874c-.08-.156-.145-.38-.18-.819c-.037-.45-.037-1.03-.037-1.89V5.8c0-.857 0-1.44.037-1.89c.036-.438.101-.663.18-.819c.192-.376.498-.682.874-.874c.156-.08.381-.145.82-.18c.45-.036 1.03-.037 1.89-.037z" clip-rule="evenodd"/></svg>
          </div>
          <div class="medsos-info">
            <span class="medsos-name">Facebook</span>
            <span class="medsos-handle">Ponpes Al-Lathifah 2</span>
          </div>
        </div>
        <Icon class="text-[18px] text-secondary-fixed" name="arrow_forward" />
      </a>
      <a class="medsos-item" href={site.kontak.mediaSosial?.tiktok || 'https://tiktok.com'} rel="noopener noreferrer" target="_blank">
        <div class="flex items-center gap-3">
          <div class="medsos-icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="0.88em" height="1em" viewBox="0 0 448 512" fill="currentColor"><title>tiktok</title><path fill="currentColor" d="M448 209.91a210.06 210.06 0 0 1-122.77-39.25v178.72A162.55 162.55 0 1 1 185 188.31v89.89a74.62 74.62 0 1 0 52.23 71.18V0h88a121 121 0 0 0 1.86 22.17A122.18 122.18 0 0 0 381 102.39a121.43 121.43 0 0 0 67 20.14Z"/></svg>
          </div>
          <div class="medsos-info">
            <span class="medsos-name">TikTok</span>
            <span class="medsos-handle">@allathifah2</span>
          </div>
        </div>
        <Icon class="text-[18px] text-secondary-fixed" name="arrow_forward" />
      </a>
      <a class="medsos-item" href={site.kontak.mediaSosial?.youtube || 'https://youtube.com'} rel="noopener noreferrer" target="_blank">
        <div class="flex items-center gap-3">
          <div class="medsos-icon-wrap" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><title>youtube-line</title><path fill="none" stroke="currentColor" stroke-linejoin="round" stroke-miterlimit="10" stroke-width="1.5" d="M22.54 6.42a2.77 2.77 0 0 0-1.945-1.957C18.88 4 12 4 12 4s-6.88 0-8.595.463A2.77 2.77 0 0 0 1.46 6.42C1 8.148 1 11.75 1 11.75s0 3.602.46 5.33a2.77 2.77 0 0 0 1.945 1.958C5.121 19.5 12 19.5 12 19.5s6.88 0 8.595-.462a2.77 2.77 0 0 0 1.945-1.958c.46-1.726.46-5.33.46-5.33s0-3.602-.46-5.33ZM9.75 15.021V8.48l5.75 3.271z"/></svg>
          </div>
          <div class="medsos-info">
            <span class="medsos-name">YouTube</span>
            <span class="medsos-handle">Ponpes Al-Lathifah 2 Official</span>
          </div>
        </div>
        <Icon class="text-[18px] text-secondary-fixed" name="arrow_forward" />
      </a>
    </div>
  </div>

  <!-- Kontak & Sekretariat PSB Section Header -->
  <div class="kontak-section-header">
    <span class="kontak-section-label">Layanan Informasi Resmi</span>
    <h2 id="kontak-title" class="kontak-section-title">Kontak & Sekretariat PSB</h2>
    <p class="kontak-section-subtext">Silakan hubungi asatidz narahubung kami untuk konsultasi santri baru.</p>
    <div class="kontak-section-divider" aria-hidden="true"></div>
  </div>

  <!-- 2 Kartu Narahubung Resmi -->
  <div class="flex flex-col gap-space-sm">
    <!-- Narahubung 1 -->
    <div class="narahubung-card">
      <div class="narahubung-header">
        <div class="narahubung-avatar" aria-hidden="true">
          <Icon class="text-[22px]" name="person" />
        </div>
        <div class="flex flex-col min-w-0">
          <span class="narahubung-name">Ust. Abdul Khair Nursa Ilma, S.Pd</span>
          <span class="narahubung-role">0896-7931-3820 — Panitia PSB</span>
        </div>
      </div>
      <a
        class="btn-cta-secondary"
        href={site.whatsappLink}
        rel="noopener noreferrer"
        target="_blank"
      >
        <Icon class="text-[18px]" name="chat" />
        <span>Tanya via WhatsApp</span>
      </a>
    </div>

    <!-- Narahubung 2 -->
    <div class="narahubung-card">
      <div class="narahubung-header">
        <div class="narahubung-avatar" aria-hidden="true">
          <Icon class="text-[22px]" name="person" />
        </div>
        <div class="flex flex-col min-w-0">
          <span class="narahubung-name">Ust. Aldi Wahid Alfaini, S.Li, Gr</span>
          <span class="narahubung-role">0817-0307-2269 — Panitia PSB</span>
        </div>
      </div>
      <a
        class="btn-cta-secondary"
        href={site.whatsappAdminLink}
        rel="noopener noreferrer"
        target="_blank"
      >
        <Icon class="text-[18px]" name="chat" />
        <span>Tanya via WhatsApp</span>
      </a>
    </div>
  </div>

  <!-- Informasi Resmi Sekretariat & Yayasan -->
  <div class="bg-[#00261b] p-space-md rounded-2xl flex flex-col gap-2.5 shadow-md">
    <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary-fixed font-bold">Portal & Korespondensi</span>
    <div class="flex items-center gap-2.5 font-body-sm text-body-sm text-white">
      <Icon class="text-[18px] text-secondary-fixed" name="language" />
      <a class="hover:underline" href={`https://${site.kontak.website}`} rel="noopener noreferrer" target="_blank">{site.kontak.website}</a>
    </div>
    <div class="flex items-center gap-2.5 font-body-sm text-body-sm text-white">
      <Icon class="text-[18px] text-secondary-fixed" name="mail" />
      <a class="hover:underline" href={`mailto:${site.kontak.email}`}>{site.kontak.email}</a>
    </div>
  </div>
</section>