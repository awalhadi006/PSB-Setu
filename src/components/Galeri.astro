---
import kegiatan1 from '@/assets/kegiatan 1.jpg';
import kegiatan2 from '@/assets/kegiatan 2.jpg';
import kegiatan3 from '@/assets/kegiatan 3.jpg';
import kegiatan4 from '@/assets/kegiatan 4.jpg';
import kegiatan5 from '@/assets/kegiatan 5.jpg';
import pramuka from '@/assets/Kegiatan Pramuka.jpeg';
import pbbTingkatII from '@/assets/PBB Lomba Tingkat II.jpeg';
import lombaMasak from '@/assets/Jambore Lomba Masak.jpeg';
import juaraUmumJambore from '@/assets/Juara Umum Jambore.jpeg';
import juaraTingkatII from '@/assets/Juara Lomba Tingkat II.jpeg';
import juaraUmumTingkatII from '@/assets/Juara Lomba Tingkat II(2).jpeg';
import oborApiUnggun from '@/assets/Api Unggun.jpeg';
import penyalaanApiUnggun from '@/assets/APi Unggun 1.jpeg';
import lombaEstafet from '@/assets/17 Agustus 1.jpeg';
import lombaKetangkasan from '@/assets/Lomba 17 Agustus.jpeg';
import rihlahFlyingFox from '@/assets/Rihlah .jpeg';
import rihlahPutri from '@/assets/Rihlah 2.jpeg';
import rihlahPutra from '@/assets/Rihlah 3.jpeg';
import pelepasanKelas9 from '@/assets/Pelepasan Kelas 9.jpeg';

const galeriImages = [
  {
    src: kegiatan1.src,
    alt: 'Santri putra menulis catatan saat pembelajaran di kelas',
    caption: 'Kegiatan Pembelajaran di Kelas',
  },
  {
    src: kegiatan2.src,
    alt: 'Foto bersama dewan ustadz dan ustadzah Pondok Pesantren Al-Lathifah 2',
    caption: 'Dewan Ustadz & Ustadzah',
  },
  {
    src: kegiatan3.src,
    alt: 'Santri putri berbaris dalam upacara Hari Santri 2024',
    caption: 'Peringatan Hari Santri',
  },
  {
    src: kegiatan4.src,
    alt: "Halaqah Qur'an santri putra bersama ustadz di serambi masjid",
    caption: "Halaqah Qur'an",
  },
  {
    src: kegiatan5.src,
    alt: 'Santri putri menggunakan komputer di laboratorium komputer',
    caption: 'Praktik Komputer di Laboratorium',
  },
  {
    src: pramuka.src,
    alt: 'Empat santri putri berpakaian pramuka berfoto bersama',
    caption: 'Kebersamaan Pramuka',
  },
  {
    src: pbbTingkatII.src,
    alt: 'Regu pramuka putri tampil dalam lomba PBB tingkat II',
    caption: 'Lomba PBB Tingkat II',
  },
  {
    src: lombaMasak.src,
    alt: 'Santri putra menyiapkan bahan masakan dalam lomba masak jambore',
    caption: 'Lomba Masak Jambore',
  },
  {
    src: juaraUmumJambore.src,
    alt: 'Foto bersama santri dan pembina dengan piala juara umum jambore',
    caption: 'Juara Umum Jambore',
  },
  {
    src: juaraTingkatII.src,
    alt: 'Santri putra berfoto dengan piala dan vandel juara lomba tingkat II',
    caption: 'Juara Lomba Tingkat II',
  },
  {
    src: juaraUmumTingkatII.src,
    alt: 'Foto bersama santri putra dan putri dengan piala juara umum lomba tingkat II',
    caption: 'Juara Umum Lomba Tingkat II',
  },
  {
    src: oborApiUnggun.src,
    alt: 'Santri membawa obor saat upacara api unggun',
    caption: 'Obor Api Unggun',
  },
  {
    src: penyalaanApiUnggun.src,
    alt: 'Santri putra menyalakan api unggun pramuka',
    caption: 'Penyalaan Api Unggun',
  },
  {
    src: lombaEstafet.src,
    alt: 'Santri putri mengikuti lomba estafet air memperingati 17 Agustus',
    caption: 'Lomba Estafet Air 17 Agustus',
  },
  {
    src: lombaKetangkasan.src,
    alt: 'Santri putra mengikuti lomba ketangkasan 17 Agustus',
    caption: 'Lomba Ketangkasan 17 Agustus',
  },
  {
    src: rihlahFlyingFox.src,
    alt: 'Santri putri bersiap menaiki flying fox saat rihlah',
    caption: 'Kegiatan Rihlah Santri Putri',
  },
  {
    src: rihlahPutri.src,
    alt: 'Santri putri berfoto bersama mengenakan helm saat rihlah',
    caption: 'Kebersamaan Rihlah Santri Putri',
  },
  {
    src: rihlahPutra.src,
    alt: 'Foto bersama santri putra di The NICE Funtastic Park saat rihlah',
    caption: 'Rihlah Santri Putra',
  },
  {
    src: pelepasanKelas9.src,
    alt: 'Santri putri duduk berbaris dalam acara pelepasan kelas 9',
    caption: 'Pelepasan Kelas 9',
  },
];

// Clone slide terakhir di depan dan slide pertama di belakang
// supaya perpindahan antar slide selalu satu arah (tidak "balik" saat loop).
const loopImages = [galeriImages[galeriImages.length - 1], ...galeriImages, galeriImages[0]];
const lastLoopIndex = loopImages.length - 1;
---

<section id="galeri-dokumentasi" class="section bg-[#fbf7ee] text-on-surface" aria-labelledby="galeri-title">
  <div class="section-header">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary-container/30 text-on-secondary-container mb-1 shadow-sm">
      <span class="material-symbols-outlined text-[16px] text-secondary" aria-hidden="true">photo_camera</span>
      <span class="font-label-sm text-label-sm font-bold uppercase tracking-wider">Dokumentasi Asli Kehidupan Kampus 24 Jam</span>
    </div>
    <h2 id="galeri-title" class="section-title-md3">Galeri Dokumentasi & Suasana Santri</h2>
    <p class="section-subtext">Potret keseharian santri dalam menuntut ilmu, beribadah, dan mengasah potensi.</p>
    <div class="section-divider" aria-hidden="true"></div>
  </div>

  <!-- Slideshow -->
  <div>
    <div class="relative">
      <div
        id="galeri-slideshow"
        class="overflow-hidden rounded-2xl bg-surface-container-lowest focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        role="region"
        aria-roledescription="carousel"
        aria-label="Galeri foto kegiatan santri"
        tabindex="0"
      >
        <div
          class="flex"
          id="galeri-track"
          style="transform: translateX(-100%)"
        >
          {loopImages.map((img, i) => {
            const isClone = i === 0 || i === lastLoopIndex;
            const realIndex = i === 0 ? galeriImages.length - 1 : i === lastLoopIndex ? 0 : i - 1;
            return (
              <div
                class="flex-shrink-0 w-full h-[280px] md:h-[380px] lg:h-[420px] relative overflow-hidden"
                data-real-index={realIndex}
                data-caption={img.caption}
                aria-hidden={isClone ? 'true' : undefined}
              >
                <img
                  src={img.src}
                  alt={isClone ? '' : img.alt}
                  class="absolute inset-0 w-full h-full object-cover"
                  loading={realIndex < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/60 via-transparent to-transparent" aria-hidden="true"></div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Navigation Buttons -->
      <button
        id="galeri-prev"
        class="absolute left-2 md:left-4 top-1/2 -translate-y-1/2 w-11 h-11 md:w-12 md:h-12 rounded-full bg-primary/70 backdrop-blur-sm text-white ring-1 ring-white/30 shadow-lg shadow-black/20 flex items-center justify-center hover:bg-primary/90 hover:ring-white/50 active:scale-95 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
        aria-label="Foto sebelumnya"
        type="button"
      >
        <span class="material-symbols-outlined text-[24px]">chevron_left</span>
      </button>
      <button
        id="galeri-next"
        class="absolute right-2 md:right-4 top-1/2 -translate-y-1/2 w-11 h-11 md:w-12 md:h-12 rounded-full bg-primary/70 backdrop-blur-sm text-white ring-1 ring-white/30 shadow-lg shadow-black/20 flex items-center justify-center hover:bg-primary/90 hover:ring-white/50 active:scale-95 transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-secondary"
        aria-label="Foto selanjutnya"
        type="button"
      >
        <span class="material-symbols-outlined text-[24px]">chevron_right</span>
      </button>
    </div>

    <!-- Caption -->
    <div class="flex justify-center mt-3 px-2">
      <p id="galeri-caption" class="galeri-caption inline-flex items-center gap-1.5 max-w-full px-3 py-1 rounded-full bg-surface-container-lowest text-on-surface-variant font-body-sm text-body-sm shadow-sm">
        <span class="material-symbols-outlined text-[15px] text-secondary shrink-0" aria-hidden="true">photo_camera</span>
        <span id="galeri-caption-text" class="truncate min-w-0">{galeriImages[0].caption}</span>
      </p>
    </div>

    <!-- Dots Indicator -->
    <div id="galeri-dots" class="flex flex-wrap justify-center gap-1.5 mt-3" role="tablist" aria-label="Indikator slide galeri">
      {galeriImages.map((_, i) => (
        <button
          class={`w-2 h-2 rounded-full transition-all duration-300 ${i === 0 ? 'bg-primary w-5' : 'bg-on-surface-variant/40'}`}
          data-index={i}
          role="tab"
          aria-label={`Slide ${i + 1}: ${galeriImages[i].caption}`}
          aria-selected={i === 0}
          type="button"
        ></button>
      ))}
    </div>
  </div>
</section>

<style>
  #galeri-track {
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .galeri-caption {
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .galeri-caption.is-swapping {
    opacity: 0;
    transform: translateY(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    #galeri-track {
      transition: none;
    }

    .galeri-caption {
      transition: none;
    }
  }
</style>

<script is:inline>
  // Galeri Slideshow — loop satu arah (clone di kedua ujung)
  (function () {
    const slideshow = document.getElementById('galeri-slideshow');
    const track = document.getElementById('galeri-track');
    const prevBtn = document.getElementById('galeri-prev');
    const nextBtn = document.getElementById('galeri-next');
    const dotsContainer = document.getElementById('galeri-dots');
    const captionEl = document.getElementById('galeri-caption');
    const captionTextEl = document.getElementById('galeri-caption-text');

    if (!slideshow || !track) return;

    const slides = Array.from(track.children);
    const realCount = slides.length - 2; // buang 2 clone
    const dots = dotsContainer ? Array.from(dotsContainer.children) : [];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const AUTOPLAY_MS = 5000;

    // Caption per slide asli
    const captions = [];
    slides.forEach((slide) => {
      captions[Number(slide.dataset.realIndex)] = slide.dataset.caption || '';
    });

    let position = 1; // 0 dan realCount+1 adalah clone
    let isAnimating = false;
    let autoTimer = null;
    let settleTimer = null;
    let captionTimer = null;
    const pauseReasons = new Set();

    function realIndexOf(pos) {
      if (pos <= 0) return realCount - 1;
      if (pos >= realCount + 1) return 0;
      return pos - 1;
    }

    function applyPosition(pos, animate) {
      position = pos;
      clearTimeout(settleTimer);

      if (!animate || reduceMotion) {
        isAnimating = false;
        track.style.transition = 'none';
        track.style.transform = 'translateX(-' + pos * 100 + '%)';
        void track.offsetWidth; // flush style sebelum transisi berikutnya
        track.style.transition = '';
        return;
      }

      isAnimating = true;
      track.style.transform = 'translateX(-' + pos * 100 + '%)';
      // fallback kalau transitionend tidak terpanggil
      settleTimer = setTimeout(() => {
        isAnimating = false;
        settle();
      }, 700);
    }

    // Setelah sampai di clone, lompat diam-diam ke slide asli pasangannya
    function settle() {
      if (isAnimating) return;
      clearTimeout(settleTimer);
      if (position === 0) {
        applyPosition(realCount, false);
      } else if (position === realCount + 1) {
        applyPosition(1, false);
      }
    }

    function updateDots(realIndex) {
      dots.forEach((dot, i) => {
        const active = i === realIndex;
        dot.classList.toggle('bg-primary', active);
        dot.classList.toggle('w-5', active);
        dot.classList.toggle('bg-on-surface-variant/40', !active);
        dot.setAttribute('aria-selected', String(active));
      });
    }

    function updateCaption(realIndex, animate) {
      if (!captionTextEl) return;
      const text = captions[realIndex] || '';
      if (captionTextEl.textContent.trim() === text) return;

      clearTimeout(captionTimer);

      if (!animate || reduceMotion || !captionEl) {
        captionEl?.classList.remove('is-swapping');
        captionTextEl.textContent = text;
        return;
      }

      captionEl.classList.add('is-swapping');
      captionTimer = setTimeout(() => {
        captionTextEl.textContent = text;
        captionEl.classList.remove('is-swapping');
      }, 170);
    }

    function render(pos, animate) {
      const target = Math.max(0, Math.min(pos, realCount + 1));
      applyPosition(target, animate);
      const realIndex = realIndexOf(target);
      updateDots(realIndex);
      updateCaption(realIndex, animate);
      preloadAhead(target);
      if (!animate || reduceMotion) settle();
    }

    // Muat 2 foto berikutnya lebih dulu supaya tidak kosong saat transisi
    function preloadAhead(pos) {
      for (let step = 1; step <= 2; step++) {
        const slide = slides[(pos + step) % slides.length];
        const img = slide ? slide.querySelector('img') : null;
        const src = img ? img.getAttribute('src') : null;
        if (!src) continue;
        const pre = new Image();
        pre.src = src;
      }
    }

    // --- Autoplay: satu timer, tidak pernah menumpuk ---
    function stopAuto() {
      if (autoTimer) {
        clearTimeout(autoTimer);
        autoTimer = null;
      }
    }

    function scheduleAuto() {
      stopAuto();
      if (reduceMotion || pauseReasons.size > 0) return;

      autoTimer = setTimeout(() => {
        autoTimer = null;
        next();
      }, AUTOPLAY_MS);
    }

    function pause(reason) {
      pauseReasons.add(reason);
      stopAuto();
    }

    function resume(reason) {
      if (!pauseReasons.delete(reason)) return;
      scheduleAuto();
    }

    // --- Navigasi ---
    function next() {
      render(position + 1, true);
      scheduleAuto();
    }

    function prev() {
      render(position - 1, true);
      scheduleAuto();
    }

    function goTo(realIndex) {
      render(realIndex + 1, true);
      scheduleAuto();
    }

    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        goTo(parseInt(dot.dataset.index, 10));
      });
    });

    track.addEventListener('transitionend', (event) => {
      if (event.target !== track || event.propertyName !== 'transform') return;
      isAnimating = false;
      settle();
    });

    // --- Pause saat hover / fokus / tab tidak aktif / di luar layar ---
    slideshow.addEventListener('mouseenter', () => pause('hover'));
    slideshow.addEventListener('mouseleave', () => resume('hover'));

    slideshow.addEventListener('focusin', () => pause('focus'));
    slideshow.addEventListener('focusout', (event) => {
      if (!slideshow.contains(event.relatedTarget)) resume('focus');
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pause('hidden');
      else resume('hidden');
    });

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) resume('offscreen');
            else pause('offscreen');
          });
        },
        { threshold: 0.35 }
      );
      observer.observe(slideshow);
    }

    // --- Keyboard ---
    slideshow.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        next();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        prev();
      }
    });

    // --- Swipe ---
    let touchStartX = 0;
    slideshow.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0].clientX;
      pause('touch');
    }, { passive: true });

    slideshow.addEventListener('touchend', (event) => {
      const diff = touchStartX - event.changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) next();
        else prev();
      }
      resume('touch');
    }, { passive: true });

    // --- Init ---
    render(1, false);
    scheduleAuto();
  })();
</script>
