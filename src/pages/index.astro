              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-title-md text-title-md text-on-surface font-semibold truncate">Ust. Abdul Khair Nursa Ilma, S.Pd</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">0896-7931-3820 — Panitia PSB</p>
            </div>
            <Icon class="text-on-surface-variant text-[20px]" name="chevron_right" />
          </a>
          <a
            href={site.whatsappAdminLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors"
          >
<div class="w-10 h-10 rounded-full bg-wa-green/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-wa-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-title-md text-title-md text-on-surface font-semibold truncate">Ust. Aldi Wahid Alfaini, S.Li, Gr</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">0817-0307-2269 — Panitia PSB</p>
            </div>
            <Icon class="text-on-surface-variant text-[20px]" name="chevron_right" />
          </a>
</div>
      </div>
    </div>
  </div>

  <Footer />

  <!-- Page interactions + animations.
       Bundled by Vite from node_modules (no CDN, no import map). GSAP is split
       into its own chunk and fetched only after the page has loaded, so it never
       competes with the hero photo - the LCP element - for bandwidth. -->
  <script>
    // 1. ANIMATION SETUP
    async function initAnimations() {
      // Respect the OS "reduce motion" setting: skip every tween entirely.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      // ==========================================
      // JADWAL STEPS TIMELINE ANIMATION (scroll-triggered)
      // ==========================================
      var jadwalSteps = document.querySelectorAll('#jadwal .jadwal-step');
      jadwalSteps.forEach(function(step, index) {
        // Initially hide steps (except first one)
        if (index > 0) {
          gsap.set(step, { opacity: 0, y: 30 });
        }

        gsap.to(step, {
          scrollTrigger: {
            trigger: step,
            start: 'top 85%',
            end: 'bottom 20%',
            toggleActions: 'play reverse play reverse',
            scrub: 0.5,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
        });
      });

      // ==========================================
      // CARD HOVER/TAP LIFT
      // ==========================================
      var cards = document.querySelectorAll('.card-elevated, .card-elevated-lg, .card-surface-low, .syarat-item, .almamater-item, .narahubung-card, .biaya-content, .misi-card, .galeri-card, .step-card');
      cards.forEach(function(card) {
        // Kept as `any`: a GSAP tween handle, only ever used for .kill().
        var hoverTween: any = null;
        
        card.addEventListener('mouseenter', function() {
          hoverTween = gsap.to(card, {
            y: -4,
            boxShadow: '0 20px 40px rgba(0,0,0,0.12)',
            duration: 0.3,
            ease: 'power2.out',
          });
        });
        
        card.addEventListener('mouseleave', function() {
          hoverTween?.kill();
          gsap.to(card, {
            y: 0,
            boxShadow: '0 4px 12px rgba(0,0,0,0.08)',
            duration: 0.3,
            ease: 'power2.out',
          });
        });
        
        // Touch support
        card.addEventListener('touchstart', function() {
          gsap.to(card, { y: -4, boxShadow: '0 20px 40px rgba(0,0,0,0.12)', duration: 0.2 });
        }, { passive: true });
        
        card.addEventListener('touchend', function() {
          gsap.to(card, { y: 0, boxShadow: '0 4px 12px rgba(0,0,0,0.08)', duration: 0.3 });
        }, { passive: true });
      });

      // ==========================================
      // WA FAB PULSE
      // ==========================================
      var waFab = document.querySelector('.btn-wa-fab');
      if (waFab) {
        gsap.to(waFab, {
          scale: 1.05,
          duration: 1.5,
          ease: 'power1.inOut',
          yoyo: true,
          repeat: -1,
        });
      }

      // ==========================================
      // RECALCULATE TRIGGERS
      // ==========================================
      // We only run after `load`, so measurements are already final. Web fonts
      // can still shift layout, so refresh once more when they settle.
      ScrollTrigger.refresh();
      if (document.fonts) {
        document.fonts.ready.then(function() {
          ScrollTrigger.refresh();
        });
      }
    }

    // 3. Tab switcher for Rincian Biaya
    function switchBiayaTab(tabName: string) {
      var tabs = ['umum', 'dhuafa', 'yatim'];
      tabs.forEach(function(t) {
        var btn = document.getElementById('tab-btn-' + t);
        var content = document.getElementById('content-' + t);
        if (t === tabName) {
          btn?.classList.add('active');
          btn?.classList.remove('inactive');
          btn?.setAttribute('aria-selected', 'true');
          content?.classList.remove('hidden');
        } else {
          btn?.classList.remove('active');
          btn?.classList.add('inactive');
          btn?.setAttribute('aria-selected', 'false');
          content?.classList.add('hidden');
        }
      });
      // Each category scrambles once per page load. Coming back to a panel that
      // has already played shows the final numbers immediately, so the figures
      // can be compared without waiting for the animation again.
      if (biayaPlayed[tabName]) {
        settleBiayaPanel(tabName);
        return;
      }

      // First visit to a panel: play right away if it is already on screen,
      // otherwise its observer picks it up when it scrolls into view.
      var shown = document.getElementById('content-' + tabName);
      if (shown) {
        var rect = shown.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          animateBiayaPanel(tabName);
        }
      }
    }

    // 4. Biaya figures: the numbers flicker through random digits, then resolve
    //    into the real value. It is not a 0-to-value count: every figure keeps
    //    its own length and separators, so nothing jumps while the numbers spin.
    var biayaAnimations: Record<string, number> = {};
    var biayaPlayed: Record<string, boolean> = {};       // tabName -> true once its figures have scrambled
    var BIAYA_SPIN_MS = 1200;   // pure random digits
    var BIAYA_LOCK_MS = 800;    // digits resolve left to right
    var BIAYA_TICK_MS = 55;     // how often the random digits change

    function biayaTarget(el: HTMLElement) {
      // Cache the value that is rendered in the HTML, so no data file is needed
      if (!el.dataset.target) {
        var text = el.textContent || '';
        el.dataset.target = String(parseInt(text.replace(/\D/g, ''), 10) || 0);
      }
      return parseInt(el.dataset.target, 10) || 0;
    }

    // Swap every not-yet-locked digit for a random one, keeping "Rp" and the
    // thousands separators in place so the figure never changes width.
    function scrambleFigure(realText: string, locked: number) {
      var out = '';
      var seen = 0;
      for (var i = 0; i < realText.length; i++) {
        var ch = realText.charAt(i);
        if (ch < '0' || ch > '9') {
          out += ch;
          continue;
        }
        if (seen < locked) {
          out += ch;
        } else if (seen === 0) {
          // Never lead with a 0: it would read as a malformed amount
          out += String(1 + Math.floor(Math.random() * 9));
        } else {
          out += String(Math.floor(Math.random() * 10));
        }
        seen++;
      }
      return out;
    }

    function animateBiayaPanel(tabName: string) {
      var panel = document.getElementById('content-' + tabName);
      if (!panel) return;

      // Mark before the first frame: switching tabs mid-scramble must not
      // trigger a second run.
      biayaPlayed[tabName] = true;

      // Every figure spins at the same time. GRATIS rows keep their static text.
      var els = Array.prototype.slice.call(
        panel.querySelectorAll('.biaya-row-value:not(.biaya-row-value-free), .biaya-total-value')
      ) as HTMLElement[];
      if (els.length === 0) return;

      var targets = els.map(function(el: HTMLElement) {
        var value = biayaTarget(el);
        var text = 'Rp' + value.toLocaleString('id-ID');
        return {
          el: el,
          text: text,
          digits: text.replace(/\D/g, '').length,
          locked: -1,
        };
      });

      // Cancel a previous run for this panel so rapid tab clicks stay readable
      if (biayaAnimations[tabName]) cancelAnimationFrame(biayaAnimations[tabName]);

      // Reduced motion: show the real numbers straight away
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var total = BIAYA_SPIN_MS + BIAYA_LOCK_MS;
      var start = performance.now();
      var lastRender = 0;

      var frame = function(now: number) {
        var elapsed = now - start;
        var done = reduce || elapsed >= total;
        var lockProgress = reduce ? 1 : Math.min(
          Math.max((elapsed - BIAYA_SPIN_MS) / BIAYA_LOCK_MS, 0),
          1
        );
        var tick = now - lastRender >= BIAYA_TICK_MS;

        targets.forEach(function(t) {
          if (done) {
            if (t.locked !== t.digits) {
              t.locked = t.digits;
              t.el.textContent = t.text;
            }
            return;
          }
          var locked = Math.floor(lockProgress * t.digits);
          if (!tick && locked === t.locked) return;
          t.locked = locked;
          t.el.textContent = scrambleFigure(t.text, locked);
        });

        if (done) {
          delete biayaAnimations[tabName];
        } else {
          if (tick) lastRender = now;
          biayaAnimations[tabName] = requestAnimationFrame(frame);
        }
      };
      biayaAnimations[tabName] = requestAnimationFrame(frame);
    }

    // Put a panel straight on its real numbers (and stop any run in flight).
    function settleBiayaPanel(tabName: string) {
      if (biayaAnimations[tabName]) {
        cancelAnimationFrame(biayaAnimations[tabName]);
        delete biayaAnimations[tabName];
      }
      var panel = document.getElementById('content-' + tabName);
      if (!panel) return;
      var els = panel.querySelectorAll(
        '.biaya-row-value:not(.biaya-row-value-free), .biaya-total-value'
      );
      Array.prototype.forEach.call(els, function(el: HTMLElement) {
        el.textContent = 'Rp' + biayaTarget(el).toLocaleString('id-ID');
      });
    }

    // 5. Accordion toggle for FAQ
    function toggleFaq(button: HTMLElement) {
      var content = button.nextElementSibling;
      var icon = button.querySelector<HTMLElement>('.faq-icon');
      var isExpanded = button.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        content?.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        if (icon) icon.style.transform = 'rotate(0deg)';
      } else {
        content?.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
        if (icon) icon.style.transform = 'rotate(180deg)';
      }
    }

    // 6. Header visibility: hidden only at the very top of the page, pinned
    //    while the user scrolls (it never slides away mid-page).
    var header = document.querySelector('header');
    if (header) {
      // Narrowed once: the closure below must not see `header` as nullable.
      var headerEl = header;
      var threshold = 4;
      var lastVisible: boolean | null = null;
      var updateHeader = function() {
        var visible = window.scrollY > threshold;
        if (visible === lastVisible) return;
        lastVisible = visible;
        headerEl.classList.toggle('hidden', !visible);
        // Drop any leftover offset from the old auto-hide behaviour.
        headerEl.classList.remove('-translate-y-full');
      };
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });
    }

    // 7. Jadwal timeline line: tepat dari nomor 1 ke nomor 4
    // Garis statis (tidak ikut animasi step) supaya tetap menyatu saat step fade/geser.
    function layoutJadwalLine() {
      var timeline = document.querySelector<HTMLElement>('#jadwal .jadwal-timeline');
      var line = timeline ? timeline.querySelector<HTMLElement>('.jadwal-timeline-line') : null;
      var steps = timeline
        ? Array.from(timeline.querySelectorAll<HTMLElement>('.jadwal-step'))
        : [];
      if (!timeline || !line || steps.length === 0) return;

      var numberCenterY = function(step: HTMLElement) {
        var number = step.querySelector<HTMLElement>('.jadwal-step-number');
        if (!number) return 0;
        var y = 0;
        var node: HTMLElement | null = number;
        while (node && node !== timeline) {
          y += node.offsetTop;
          node = node.offsetParent as HTMLElement | null;
        }
        return y + number.offsetHeight / 2;
      };

      var start = numberCenterY(steps[0]);
      var end = numberCenterY(steps[steps.length - 1]);
      line.style.top = start + 'px';
      line.style.height = Math.max(0, end - start) + 'px';
    }

    layoutJadwalLine();
    window.addEventListener('load', layoutJadwalLine);
    window.addEventListener('resize', layoutJadwalLine);
    if (document.fonts) {
      document.fonts.ready.then(layoutJadwalLine);
    }

    // 8. Expose functions to global scope for inline onclick handlers.
    //    Harmless if a user taps before the module runs: the handlers only
    //    fire on real clicks, which happen after the deferred script executes.
    declare global {
      interface Window {
        switchBiayaTab: (tabName: string) => void;
        toggleFaq: (button: HTMLElement) => void;
      }
    }
    window.switchBiayaTab = switchBiayaTab;
    window.toggleFaq = toggleFaq;

    // 9. Scramble each biaya panel once, the first time it is actually seen.
    //    Every panel gets its own observer, so a panel only plays when it is on
    //    screen (no animation burned off-screen). The observer watches the panel
    //    itself, not #biaya: the section header and tabs sit above the figures.
    function initBiayaCounters() {
      if (!('IntersectionObserver' in window)) return; // static figures stay

      var panels = document.querySelectorAll<HTMLElement>('.biaya-content');
      Array.prototype.forEach.call(panels, function(panel: HTMLElement) {
        var tabName = panel.id.replace('content-', '');
        var observer = new IntersectionObserver(
          function(entries) {
            if (!entries.some(function(e) { return e.isIntersecting; })) return;
            observer.disconnect();
            if (biayaPlayed[tabName]) return;
            animateBiayaPanel(tabName);
          },
          { threshold: 0.45, rootMargin: '0px 0px -10% 0px' }
        );
        observer.observe(panel);
      });
    }

    initBiayaCounters();

    // 10. Kick off animation setup once the page is loaded and the main thread is
    //     free. GSAP is a ~40 KB chunk; requesting it earlier would slow down the
    //     hero photo, which is the element being measured for LCP.
    function startWhenIdle() {
      var run = function() {
        initAnimations().catch(function(err) {
          console.error('[animations] setup failed:', err);
        });
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(run, { timeout: 2000 });
      } else {
        setTimeout(run, 200);
      }
    }

    if (document.readyState === 'complete') {
      startWhenIdle();
    } else {
      window.addEventListener('load', startWhenIdle, { once: true });
    }
  </script>
</BaseLayout>

<style is:global>
  /* WhatsApp FAB anchor: a comfortable gap from the corner, plus the iOS
     home-indicator inset (the viewport uses viewport-fit=cover). */
  .wa-fab-anchor {
    right: calc(1.5rem + env(safe-area-inset-right, 0px));
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
  }
  @media (min-width: 768px) {
    .wa-fab-anchor {
      right: calc(2rem + env(safe-area-inset-right, 0px));
      bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
    }
  }

  #wa-overlay .wa-panel {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: calc(100% - 2rem);
    max-width: 24rem;
  }
  @media (max-width: 767px) {
    #wa-overlay .wa-panel {
      top: 50%;
      bottom: auto;
      right: 0;
      left: 0;
      margin: 0 auto;
      transform: translateY(-50%);
    }
    #wa-overlay .wa-panel.animate-slide-up {
      animation: slide-up-center 0.25s ease-out;
    }
  }
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes slide-up-center {
    from {
      opacity: 0;
      transform: translateY(-50%) translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%);
    }
  }
  .animate-slide-up {
    animation: slide-up 0.25s ease-out;
  }
</style>

<script is:inline>
  (function () {
    // WhatsApp FAB Overlay
    const fabBtn = document.getElementById('wa-fab-btn');
    const overlay = document.getElementById('wa-overlay');
    const closeBtn = document.getElementById('wa-overlay-close');

    function openWaOverlay() {
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeWaOverlay() {
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    fabBtn?.addEventListener('click', openWaOverlay);
    closeBtn?.addEventListener('click', closeWaOverlay);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeWaOverlay();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('hidden')) {
        closeWaOverlay();
      }
    });
  })();
</script>