      </svg>
    </button>
  </aside>

  <!-- WhatsApp Contact Overlay -->
  <div id="wa-overlay" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="wa-overlay-title">
    <div class="wa-panel animate-slide-up">
      <div class="bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden">
        <div class="p-4 bg-primary-container text-on-primary flex items-center justify-between">
          <h3 id="wa-overlay-title" class="font-title-lg text-title-lg font-semibold">Hubungi Panitia PSB</h3>
          <button id="wa-overlay-close" class="w-8 h-8 rounded-full bg-surface-container text-on-surface flex items-center justify-center" aria-label="Tutup">
            <Icon class="text-[20px]" name="close" />
          </button>
        </div>
        <div class="p-3 space-y-2">
          <a
            href={site.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors"
          >
            <div class="w-10 h-10 rounded-full bg-wa-green/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-wa-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-title-md text-title-md text-on-surface font-semibold truncate">Ust. Abdul Khair Nursa Ilma, S.Pd</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">0896-7931-3820 — Panitia PSB</p>
            </div>
            <Icon class="text-on-surface-variant text-[20px]" name="chevron_right" />
          </a>
          <a
            href={site.whatsappAdminLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors"
          >
<div class="w-10 h-10 rounded-full bg-wa-green/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-wa-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-title-md text-title-md text-on-surface font-semibold truncate">Ust. Aldi Wahid Alfaini, S.Li, Gr</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">0817-0307-2269 — Panitia PSB</p>
            </div>
            <Icon class="text-on-surface-variant text-[20px]" name="chevron_right" />
          </a>
</div>
      </div>
    </div>
  </div>

  <Footer />

  <!-- Page interactions + animations.
       Bundled by Vite from node_modules (no CDN, no import map). GSAP is split
       into its own chunk and fetched only after the page has loaded, so it never
       competes with the hero photo - the LCP element - for bandwidth. -->
  <script>
    // 1. ANIMATION SETUP
    async function initAnimations() {
      // Respect the OS "reduce motion" setting: skip every tween entirely.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const [{ gsap }, { ScrollTrigger }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
      ]);
      gsap.registerPlugin(ScrollTrigger);

      // ==========================================
      // JADWAL STEPS TIMELINE ANIMATION (scroll-triggered)
      // ==========================================
      var jadwalSteps = document.querySelectorAll('#jadwal .jadwal-step');
      jadwalSteps.forEach(function(step, index) {
        // Initially hide steps (except first one)
        if (index > 0) {
          gsap.set(step, { opacity: 0, y: 30 });
        }

        gsap.to(step, {
          scrollTrigger: {
            trigger: step,
            start: 'top 85%',
            end: 'bottom 20%',
            toggleActions: 'play reverse play reverse',
            scrub: 0.5,
          },
          opacity: 1,
          y: 0,
          duration: 0.8,
          ease: 'power3.out',
        });
      });

      // ==========================================
      // CARD HOVER/TAP LIFT
      // ==========================================
      var cards = document.querySelectorAll('.card-elevated, .card-elevated-lg, .card-surface-low, .syarat-item, .almamater-item, .narahubung-card, .biaya-content, .misi-card, .galeri-card');
      cards.forEach(function(card) {
        var hoverTween = null;
        
        card.addEventListener('mouseenter', function() {
          hoverTween = gsap.to(card, {
            y: -4,
            boxShadow: '0 20px 40px rgba(0,0,0,0.12)',
            duration: 0.3,
            ease: 'power2.out',
          });
        });
        
        card.addEventListener('mouseleave', function() {
          hoverTween?.kill();
          gsap.to(card, {
            y: 0,
            boxShadow: '0 4px 12px rgba(0,0,0,0.08)',
            duration: 0.3,
            ease: 'power2.out',
          });
        });
        
        // Touch support
        card.addEventListener('touchstart', function() {
          gsap.to(card, { y: -4, boxShadow: '0 20px 40px rgba(0,0,0,0.12)', duration: 0.2 });
        }, { passive: true });
        
        card.addEventListener('touchend', function() {
          gsap.to(card, { y: 0, boxShadow: '0 4px 12px rgba(0,0,0,0.08)', duration: 0.3 });
        }, { passive: true });
      });

      // ==========================================
      // WA FAB PULSE
      // ==========================================
      var waFab = document.querySelector('.btn-wa-fab');
      if (waFab) {
        gsap.to(waFab, {
          scale: 1.05,
          duration: 1.5,
          ease: 'power1.inOut',
          yoyo: true,
          repeat: -1,
        });
      }

      // ==========================================
      // RECALCULATE TRIGGERS
      // ==========================================
      // We only run after `load`, so measurements are already final. Web fonts
      // can still shift layout, so refresh once more when they settle.
      ScrollTrigger.refresh();
      if (document.fonts) {
        document.fonts.ready.then(function() {
          ScrollTrigger.refresh();
        });
      }
    }

    // 3. Tab switcher for Rincian Biaya
    function switchBiayaTab(tabName) {
      var tabs = ['umum', 'dhuafa', 'yatim'];
      tabs.forEach(function(t) {
        var btn = document.getElementById('tab-btn-' + t);
        var content = document.getElementById('content-' + t);
        if (t === tabName) {
          btn?.classList.add('active');
          btn?.classList.remove('inactive');
          btn?.setAttribute('aria-selected', 'true');
          content?.classList.remove('hidden');
        } else {
          btn?.classList.remove('active');
          btn?.classList.add('inactive');
          btn?.setAttribute('aria-selected', 'false');
          content?.classList.add('hidden');
        }
      });
      // Trigger counter animation for the newly shown panel
      animateBiayaTotal(tabName);
    }

    // 4. Biaya total counter: smooth count-up
    function animateBiayaTotal(tabName) {
      var panel = document.getElementById('content-' + tabName);
      if (!panel) return;
      var totalEl = panel.querySelector('.biaya-total-value');
      if (!totalEl) return;

      // Get target from data attribute (set once on first run)
      var target = parseInt(totalEl.dataset.target || '0', 10);
      if (!target) {
        var text = totalEl.textContent || '';
        target = parseInt(text.replace(/\D/g, ''), 10);
        totalEl.dataset.target = String(target);
      }
      if (!target) return;

      var duration = 1200;
      var startTime = performance.now();
      var frame = function(now) {
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        var displayValue = Math.round(target * eased);
        totalEl.textContent = 'Rp ' + displayValue.toLocaleString('id-ID');
        if (progress < 1) {
          requestAnimationFrame(frame);
        }
      };
      requestAnimationFrame(frame);
    }

    // 5. Accordion toggle for FAQ
    function toggleFaq(button) {
      var content = button.nextElementSibling;
      var icon = button.querySelector('.faq-icon');
      var isExpanded = button.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        content?.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        icon.style.transform = 'rotate(0deg)';
      } else {
        content?.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
        icon.style.transform = 'rotate(180deg)';
      }
    }

    // 6. Header auto-hide: hide at top, show on scroll down
    var header = document.querySelector('header');
    if (header) {
      var lastScrollY = 0;
      var threshold = 4;
      window.addEventListener('scroll', function() {
        var currentScrollY = window.scrollY;

        if (currentScrollY <= threshold) {
          header.classList.add('hidden');
        } else {
          header.classList.remove('hidden');

          if (currentScrollY > lastScrollY && currentScrollY > 100) {
            header.classList.add('-translate-y-full');
          } else {
            header.classList.remove('-translate-y-full');
          }
        }
        lastScrollY = currentScrollY;
      });
    }

    // 7. Jadwal timeline line: tepat dari nomor 1 ke nomor 4
    // Garis statis (tidak ikut animasi step) supaya tetap menyatu saat step fade/geser.
    function layoutJadwalLine() {
      var timeline = document.querySelector('#jadwal .jadwal-timeline');
      var line = timeline ? timeline.querySelector('.jadwal-timeline-line') : null;
      var steps = timeline ? timeline.querySelectorAll('.jadwal-step') : [];
      if (!timeline || !line || steps.length === 0) return;

      var numberCenterY = function(step) {
        var number = step.querySelector('.jadwal-step-number');
        if (!number) return 0;
        var y = 0;
        var node = number;
        while (node && node !== timeline) {
          y += node.offsetTop;
          node = node.offsetParent;
        }
        return y + number.offsetHeight / 2;
      };

      var start = numberCenterY(steps[0]);
      var end = numberCenterY(steps[steps.length - 1]);
      line.style.top = start + 'px';
      line.style.height = Math.max(0, end - start) + 'px';
    }

    layoutJadwalLine();
    window.addEventListener('load', layoutJadwalLine);
    window.addEventListener('resize', layoutJadwalLine);
    if (document.fonts) {
      document.fonts.ready.then(layoutJadwalLine);
    }

    // 8. Expose functions to global scope for inline onclick handlers.
    //    Harmless if a user taps before the module runs: the handlers only
    //    fire on real clicks, which happen after the deferred script executes.
    window.switchBiayaTab = switchBiayaTab;
    window.toggleFaq = toggleFaq;

    // 9. Kick off animation setup once the page is loaded and the main thread is
    //    free. GSAP is a ~40 KB chunk; requesting it earlier would slow down the
    //    hero photo, which is the element being measured for LCP.
    function startWhenIdle() {
      var run = function() {
        initAnimations().catch(function(err) {
          console.error('[animations] setup failed:', err);
        });
      };
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(run, { timeout: 2000 });
      } else {
        setTimeout(run, 200);
      }
    }

    if (document.readyState === 'complete') {
      startWhenIdle();
    } else {
      window.addEventListener('load', startWhenIdle, { once: true });
    }
  </script>
</BaseLayout>

<style is:global>
  #wa-overlay .wa-panel {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: calc(100% - 2rem);
    max-width: 24rem;
  }
  @media (max-width: 767px) {
    #wa-overlay .wa-panel {
      top: 50%;
      bottom: auto;
      right: 0;
      left: 0;
      margin: 0 auto;
      transform: translateY(-50%);
    }
    #wa-overlay .wa-panel.animate-slide-up {
      animation: slide-up-center 0.25s ease-out;
    }
  }
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes slide-up-center {
    from {
      opacity: 0;
      transform: translateY(-50%) translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%);
    }
  }
  .animate-slide-up {
    animation: slide-up 0.25s ease-out;
  }
</style>

<script is:inline>
  (function () {
    // WhatsApp FAB Overlay
    const fabBtn = document.getElementById('wa-fab-btn');
    const overlay = document.getElementById('wa-overlay');
    const closeBtn = document.getElementById('wa-overlay-close');

    function openWaOverlay() {
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeWaOverlay() {
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    fabBtn?.addEventListener('click', openWaOverlay);
    closeBtn?.addEventListener('click', closeWaOverlay);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeWaOverlay();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('hidden')) {
        closeWaOverlay();
      }
    });
  })();
</script>