---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Profil from '../components/Profil.astro';
import BannerFoto from '../components/BannerFoto.astro';
import Kegiatan from '../components/Kegiatan.astro';
import Galeri from '../components/Galeri.astro';
import Pengajar from '../components/Pengajar.astro';
import Jadwal from '../components/Jadwal.astro';
import Syarat from '../components/Syarat.astro';
import Biaya from '../components/Biaya.astro';
import CaraMendaftar from '../components/CaraMendaftar.astro';
import FAQ from '../components/FAQ.astro';
import Kontak from '../components/Kontak.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

const title = 'Penerimaan Santri Baru';
const description = `Penerimaan Santri Baru ${site.nama} Tahun Ajaran ${site.tahunAjaran} - ${site.tagline}`;
---

<BaseLayout title={title} description={description}>
  <Navbar />

  <main class="flex flex-col relative w-full pt-0 bg-surface min-h-screen">
    <div class="flex flex-col w-full text-on-surface">
      {/* #beranda */}
      <Hero />

      {/* #profil */}
      <Profil />

      {/* Banner Quote */}
      <BannerFoto />

      {/* #kegiatan */}
      <Kegiatan />

      {/* #galeri-dokumentasi */}
      <Galeri />

      {/* #pengajar */}
      <Pengajar />

      {/* #jadwal */}
      <Jadwal />

      {/* #syarat */}
      <Syarat />

      {/* #biaya */}
      <Biaya />

      {/* #cara-mendaftar */}
      <CaraMendaftar />

      {/* #faq */}
      <FAQ />

      {/* #kontak */}
      <Kontak />
    </div>
  </main>

  <!-- Fixed WhatsApp FAB with Overlay -->
  <aside class="fixed right-4 z-40 bottom-3">
    <button
      id="wa-fab-btn"
      aria-label="Chat WhatsApp Panitia PSB"
      class="btn-wa-fab"
      type="button"
    >
      <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
    </button>
  </aside>

  <!-- WhatsApp Contact Overlay -->
  <div id="wa-overlay" class="hidden fixed inset-0 z-50 bg-black/40 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="wa-overlay-title">
    <div class="wa-panel animate-slide-up">
      <div class="bg-surface-container-lowest rounded-2xl shadow-xl overflow-hidden">
        <div class="p-4 bg-primary-container text-on-primary flex items-center justify-between">
          <h3 id="wa-overlay-title" class="font-title-lg text-title-lg font-semibold">Hubungi Panitia PSB</h3>
          <button id="wa-overlay-close" class="w-8 h-8 rounded-full bg-surface-container text-on-surface flex items-center justify-center" aria-label="Tutup">
            <span class="material-symbols-outlined text-[20px]">close</span>
          </button>
        </div>
        <div class="p-3 space-y-2">
          <a
            href={site.whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors"
          >
            <div class="w-10 h-10 rounded-full bg-wa-green/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-wa-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-title-md text-title-md text-on-surface font-semibold truncate">Ust. Abdul Khair Nursa Ilma, S.Pd</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">0896-7931-3820 — Panitia PSB</p>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant text-[20px]">chevron_right</span>
          </a>
          <a
            href={site.whatsappAdminLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 p-3 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors"
          >
<div class="w-10 h-10 rounded-full bg-wa-green/10 flex items-center justify-center shrink-0">
              <svg class="w-5 h-5 text-wa-green" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-title-md text-title-md text-on-surface font-semibold truncate">Ust. Aldi Wahid Alfaini, S.Li, Gr</p>
              <p class="font-body-sm text-body-sm text-on-surface-variant truncate">0817-0307-2269 — Panitia PSB</p>
            </div>
            <span class="material-symbols-outlined text-on-surface-variant text-[20px]">chevron_right</span>
          </a>
</div>
      </div>
    </div>
  </div>

  <Footer />

  <!-- Main JS entry point (inlined for Astro 5 static build) -->
  <script is:inline>
    // 1. Progressive enhancement: mark HTML as JS-ready immediately on DOMContentLoaded
    document.addEventListener('DOMContentLoaded', () => {
      document.documentElement.classList.add('js-ready');
    });

    // 2. Dynamic imports after DOM ready — keeps initial bundle small
    async function initAnimations(): Promise<void> {
      // Import GSAP core + plugins
      const [{ gsap }, { ScrollTrigger }, { SplitText }, { TextPlugin }] = await Promise.all([
        import('gsap'),
        import('gsap/ScrollTrigger'),
        import('gsap/SplitText'),
        import('gsap/TextPlugin'),
      ]);

      // Register plugins
      gsap.registerPlugin(ScrollTrigger, SplitText, TextPlugin);

      // Import and initialize GSAP animations
      const { initAnimations: initGsapAnimations } = await import('../scripts/gsap-animations.ts');
      initGsapAnimations(gsap, ScrollTrigger, SplitText, TextPlugin);
    }

    // 3. Tab switcher for Rincian Biaya
    function switchBiayaTab(tabName: string): void {
      const tabs = ['umum', 'dhuafa', 'yatim'];
      tabs.forEach((t) => {
        const btn = document.getElementById('tab-btn-' + t);
        const content = document.getElementById('content-' + t);
        if (t === tabName) {
          btn?.classList.add('active');
          btn?.classList.remove('inactive');
          btn?.setAttribute('aria-selected', 'true');
          content?.classList.remove('hidden');
        } else {
          btn?.classList.remove('active');
          btn?.classList.add('inactive');
          btn?.setAttribute('aria-selected', 'false');
          content?.classList.add('hidden');
        }
      });
      // Trigger counter animation for the newly shown panel
      animateBiayaTotal(tabName);
    }

    // 4. Biaya total counter: smooth count-up
    function animateBiayaTotal(tabName: string): void {
      const panel = document.getElementById('content-' + tabName);
      if (!panel) return;
      const totalEl = panel.querySelector('.biaya-total-value');
      if (!totalEl) return;

      // Get target from data attribute (set once on first run)
      let target = parseInt(totalEl.dataset.target || '0', 10);
      if (!target) {
        const text = totalEl.textContent || '';
        target = parseInt(text.replace(/\D/g, ''), 10);
        totalEl.dataset.target = String(target);
      }
      if (!target) return;

      const duration = 1200;
      const startTime = performance.now();
      const frame = (now: number) => {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const displayValue = Math.round(target * eased);
        totalEl.textContent = 'Rp ' + displayValue.toLocaleString('id-ID');
        if (progress < 1) {
          requestAnimationFrame(frame);
        }
      };
      requestAnimationFrame(frame);
    }

    // 5. Accordion toggle for FAQ
    function toggleFaq(button: HTMLButtonElement): void {
      const content = button.nextElementSibling as HTMLElement;
      const icon = button.querySelector('.material-symbols') as HTMLElement;
      const isExpanded = button.getAttribute('aria-expanded') === 'true';

      if (isExpanded) {
        content?.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
        icon.style.transform = 'rotate(0deg)';
      } else {
        content?.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
        icon.style.transform = 'rotate(180deg)';
      }
    }

    // 6. Header auto-hide: hide at top, show on scroll down
    const header = document.querySelector('header');
    if (header) {
      let lastScrollY = 0;
      const threshold = 4;
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;

        if (currentScrollY <= threshold) {
          header.classList.add('hidden');
          header.classList.remove('scrolled');
        } else {
          header.classList.remove('hidden');
          header.classList.add('scrolled');

          if (currentScrollY > lastScrollY && currentScrollY > 100) {
            header.classList.add('-translate-y-full');
          } else {
            header.classList.remove('-translate-y-full');
          }
        }
        lastScrollY = currentScrollY;
      });
    }

    // 7. Kick off initialization
    async function main(): Promise<void> {
      await initAnimations();

      // 8. Refresh ScrollTrigger after all images/fonts have loaded
      window.addEventListener('load', async () => {
        const { ScrollTrigger } = await import('gsap/ScrollTrigger');
        ScrollTrigger.refresh();
      });
    }

    // Expose functions to global scope for inline onclick handlers
    (window as any).switchBiayaTab = switchBiayaTab;
    (window as any).toggleFaq = toggleFaq;

    main().catch((err) => {
      console.error('[main.ts] Initialization failed:', err);
    });
  </script>
</BaseLayout>

<style is:global>
  #wa-overlay .wa-panel {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    width: calc(100% - 2rem);
    max-width: 24rem;
  }
  @media (max-width: 767px) {
    #wa-overlay .wa-panel {
      top: 50%;
      bottom: auto;
      right: 0;
      left: 0;
      margin: 0 auto;
      transform: translateY(-50%);
    }
    #wa-overlay .wa-panel.animate-slide-up {
      animation: slide-up-center 0.25s ease-out;
    }
  }
  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes slide-up-center {
    from {
      opacity: 0;
      transform: translateY(-50%) translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%);
    }
  }
  .animate-slide-up {
    animation: slide-up 0.25s ease-out;
  }
</style>

<script is:inline>
  (function () {
    // WhatsApp FAB Overlay
    const fabBtn = document.getElementById('wa-fab-btn');
    const overlay = document.getElementById('wa-overlay');
    const closeBtn = document.getElementById('wa-overlay-close');

    function openWaOverlay() {
      overlay?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeWaOverlay() {
      overlay?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    fabBtn?.addEventListener('click', openWaOverlay);
    closeBtn?.addEventListener('click', closeWaOverlay);
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay) closeWaOverlay();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.classList.contains('hidden')) {
        closeWaOverlay();
      }
    });
  })();
</script>