---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Profil from '../components/Profil.astro';
import BannerFoto from '../components/BannerFoto.astro';
import Kegiatan from '../components/Kegiatan.astro';
import Galeri from '../components/Galeri.astro';
import Pengajar from '../components/Pengajar.astro';
import Jadwal from '../components/Jadwal.astro';
import Syarat from '../components/Syarat.astro';
import Biaya from '../components/Biaya.astro';
import CaraMendaftar from '../components/CaraMendaftar.astro';
import FAQ from '../components/FAQ.astro';
import Kontak from '../components/Kontak.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { faqItems } from '../data/faq';

const title = 'Penerimaan Santri Baru';
const description = `Penerimaan Santri Baru ${site.nama} Tahun Ajaran ${site.tahunAjaran} - ${site.tagline}`;

// FAQPage markup built from the same array FAQ.astro renders, so the visible
// accordion and the structured data can never disagree.
const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={faqLd}>
  <Navbar />

  <main class="flex flex-col relative w-full pt-0 bg-surface min-h-screen">
    <div class="flex flex-col w-full text-on-surface">
      {/* #beranda */}
      <Hero />

      {/* #profil */}
      <Profil />

      {/* Banner Quote */}
      <BannerFoto />

      {/* #kegiatan */}
      <Kegiatan />

      {/* #galeri-dokumentasi */}
      <Galeri />

      {/* #pengajar */}
      <Pengajar />

      {/* #jadwal */}
      <Jadwal />

      {/* #syarat */}
      <Syarat />

      {/* #biaya */}
      <Biaya />

      {/* #cara-mendaftar */}
      <CaraMendaftar />

      {/* #faq */}
      <FAQ />

      {/* #kontak */}
      <Kontak />
    </div>
  </main>

  <!-- Fixed WhatsApp FAB with Overlay -->
  <aside class="wa-fab-anchor fixed z-40">
    <button
      id="wa-fab-btn"
      aria-label="Chat WhatsApp Panitia PSB"
      class="btn-wa-fab"
      type="button"
    >
