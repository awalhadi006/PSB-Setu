---
import { site } from '../data/site';
import { heroSrc, heroSrcset, heroSizes } from '../utils/hero-image';
import '../styles/global.css';

const props = Astro.props;
const title = props.title;
const description = props.description;
const canonicalPath = props.canonicalPath || '/';
const ogImage = props.ogImage || '/og-default.jpg';

const baseUrl = `https://${site.kontak.website}`;
const canonicalUrl = new URL(canonicalPath, baseUrl).toString();
const fullOgImageUrl = new URL(ogImage, baseUrl).toString();
const pageTitle = `${title} | ${site.nama}`;
---

<!doctype html>
<html class="light" lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="shell-type" content="mobile_tab" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalUrl} />

    <meta name="theme-color" content="#0B3D2E" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0B3D2E" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:site_name" content={site.nama} />
    <meta property="og:locale" content="id_ID" />

    <!-- Favicons (optimized sizes from Logo.png) -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Preload just the logo variant the navbar actually renders (WebP).
         Kept low priority via the <img fetchpriority="low"> in Navbar.astro. -->
    <link rel="preload" as="image" type="image/webp" href="/logo-optimized.webp" />

    <!-- LCP hero photo. Mirrors the <img srcset> in Hero.astro exactly, so the
         preload is reused instead of triggering a second download. -->
    <link
      rel="preload"
      as="image"
      href={heroSrc}
      imagesrcset={heroSrcset}
      imagesizes={heroSizes}
      fetchpriority="high"
    />


    <!-- Google Fonts (text only — icons are inline SVG, no icon webfont) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-surface text-on-surface antialiased flex flex-col min-h-screen selection:bg-secondary-container selection:text-on-secondary-container">
    <slot />
  </body>
</html>

<style is:global>
  /* Ensure html/body take full height for layout stability */
  html,
  body {
    margin: 0;
    min-height: 100%;
  }
</style>